# ═══════════════════════════════════════════════════════
#  UniStart — Environment Variables Template
# ═══════════════════════════════════════════════════════
#  Copy this file:  cp .env.example .env
#  Then fill in every value marked REQUIRED.
# ═══════════════════════════════════════════════════════

# ── PostgreSQL ──────────────────────────────────────────
POSTGRES_DB=UniStart
POSTGRES_USER=postgres
POSTGRES_PASSWORD=          # REQUIRED — database password
POSTGRES_PORT=5432

# ── ASP.NET Core ────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Production
API_PORT=5009

# ── JWT ─────────────────────────────────────────────────
JWT_SECRET_KEY=             # REQUIRED — min 32 chars
JWT_ISSUER=UniStart
JWT_AUDIENCE=UniStartUsers
JWT_EXPIRATION=1440

# ── Email (SMTP) ───────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_SSL=true
SMTP_SENDER_EMAIL=
SMTP_SENDER_NAME=UniStart
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENABLED=false

# ── LLM Extraction (OCR pipeline) ─────────────────────
LLM_PROVIDER=deepseek
LLM_API_KEY=               # REQUIRED if using OCR import
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com

# ── Google Drive sync (content pipeline) ───────────────
# Put the service-account JSON at ./secrets/drive-sa.json (gitignored, mounted into the container).
# Share the target Drive folder with the service account's client_email (Viewer access).
DRIVE_APP_NAME=UniStart
DRIVE_SA_PATH=secrets/drive-sa.json

# ── CORS ───────────────────────────────────────────────
CORS_ORIGIN=http://localhost

# ── Google OAuth (sign-in) ─────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Cloudflare R2 (image storage) ──────────────────────
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=
R2_ENDPOINT=
R2_BUCKET_NAME=

# ── Client ─────────────────────────────────────────────
CLIENT_PORT=80
